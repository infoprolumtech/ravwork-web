

pipeline {
    agent { label 'Ubuntu20'}
    tools {
        nodejs 'nodejs22'
    }

 
    environment {
        GIT_APP_REPO_URL = 'git@github.com:TechAhead-Inc/ravworklink-webapp.git'
        GIT_APP_BRANCH = 'prode'
        AWS_PROFILE = 'RavWork'
        AWS_REGION = 'us-west-1'
        S3_BUCKET = 'ravworklink-prod-admin-panel'
        CF_DISTRIBUTION_ID = 'E286OT5P529G0M'
        ENV_S3_BUCKET = 'ravworklink-prod-admin-panel'
        ENVIRONMENT   = 'dev'  
        GIT_CREDENTIALS   = 'deepaktechahead-github'
        COVERAGE_THRESHOLD = '80'
    }
 
    stages {
        stage('Clean Workspace') {
            steps {
                cleanWs()
                echo 'Workspace cleaned.'
            }
        }
 
        stage('Checkout App Code') {
            steps {
                git credentialsId: "${GIT_CREDENTIALS}", url: "${env.GIT_APP_REPO_URL}", branch: "${env.GIT_APP_BRANCH}"
            }
        }

   stage('Download env file') {
    steps {
        sh '''
          echo "Downloading environment file from S3..."
          aws s3 cp s3://ravwork-webapp-env/prod-env .env --profile ${AWS_PROFILE} --region ${AWS_REGION}
          echo "Environment file downloaded and renamed to .env"
          cat .env
          ls -la
        '''
    }
}

      stage('Install react.js dependency') {
            steps {
                 sh '''
                   npm install
                
                '''
            }
        }
 
        stage('build react.js project') {
            steps {
                 sh '''
                   npm run build
                
                '''
            }
        }

     stage('Deploy react.js project') {
            steps {
                 sh '''
                 aws s3 rm s3://${S3_BUCKET} --recursive --profile ${AWS_PROFILE}
                 aws s3 cp dist s3://${S3_BUCKET} --recursive --profile ${AWS_PROFILE}
                
                '''
            }
        }
 
 
        stage('Invalidate CloudFront Cache') {
            steps {
                sh "aws cloudfront create-invalidation --distribution-id ${CF_DISTRIBUTION_ID} --paths '/*' --profile ${AWS_PROFILE}"
            }
        }
    }
 
   post {
        success {
            echo "Deployment completed successfully!"
            emailext subject: "Jenkins Build SUCCESS: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                     body: "The Jenkins build ${env.JOB_NAME} #${env.BUILD_NUMBER} has completed successfully.\nCheck console output at ${env.BUILD_URL}.",
                     recipientProviders: [[$class: 'DevelopersRecipientProvider']],
                     to: 'shivam.yadav@techaheadcorp.com'
        }
 
        failure {
            echo "Deployment failed!"
            emailext subject: "Jenkins Build FAILED: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                     body: "The Jenkins build ${env.JOB_NAME} #${env.BUILD_NUMBER} has failed.\nCheck console output at ${env.BUILD_URL}.",
                     recipientProviders: [[$class: 'DevelopersRecipientProvider']],
                     to: 'shivam.yadav@techaheadcorp.com'
        }
    }
}
